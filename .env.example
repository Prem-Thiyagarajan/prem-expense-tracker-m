# Copy this file to `.env` and fill in values. `.env` is gitignored.

# Base URL of the Prem Expense Tracker API (must include the /api/v1 suffix).
# Local FastAPI (physical device via Expo Go needs your machine's LAN IP, not localhost):
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.1.5:8000/api/v1
# Production (Render):
#   EXPO_PUBLIC_API_BASE_URL=https://<your-render-service>.onrender.com/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
