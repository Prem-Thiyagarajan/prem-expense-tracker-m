{
  "expo": {
    "name": "ExpenseTracker",
    "slug": "expensetracker",
    "owner": "prem-thiyagarajans-team",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pft",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.premthiyagarajan.expensetracker"
    },
    "android": {
      "package": "com.premthiyagarajan.expensetracker",
      "adaptiveIcon": {
        "backgroundColor": "#FFD43B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8ED",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      "expo-updates",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow ExpenseTracker to use the microphone so you can ask the assistant by voice."
        }
      ]
    ],
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/aa2e434e-9f0f-4a61-a91b-eac837f4ab19"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aa2e434e-9f0f-4a61-a91b-eac837f4ab19"
      }
    }
  }
}
